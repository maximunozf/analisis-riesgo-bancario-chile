# ---------------------------------------------------------------------------
# .gitignore — analisis-riesgo-bancario-chile
# ---------------------------------------------------------------------------

# Entorno virtual: se recrea con `pip install -r requirements.txt`.
.venv/
venv/

# Credenciales de la base de datos. NUNCA se versionan.
# Lo que si se versiona es .env.example, que documenta las variables
# necesarias sin exponer ninguna clave.
.env

# Datos crudos de la CMF: no se versionan.
# Son ~30 MB de Excel que cualquiera regenera con scripts/descargar_cmf.py,
# y el repo se mantiene liviano y clonable.
#
# POR QUÉ se ignoran los .xlsx y NO la carpeta completa: así los .gitkeep
# siguen versionados y quien clone el repo recibe data/raw/morosidad/ y
# data/raw/provisiones/ ya creadas. Ignorando `data/raw/` entera, las carpetas
# no existirían al clonar y el script de descarga fallaría con FileNotFoundError
# antes de bajar el primer archivo.
data/raw/morosidad/*.xlsx
data/raw/provisiones/*.xlsx

# Lo que SÍ se versiona es data/processed/: el consolidado limpio es el
# resultado del trabajo de limpieza, no un insumo descargable.

# Salidas de diagnóstico y logs de corridas (no son documentación).
docs/*.txt

# Herramientas de un solo uso, no forman parte del pipeline.
scripts/diag_cmf.py
scripts/reparar_mysql.ps1

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Power BI / Excel temporales
~$*.xlsx
*.pbix.tmp

# Sistema operativo / editor
Thumbs.db
.DS_Store
.vscode/
