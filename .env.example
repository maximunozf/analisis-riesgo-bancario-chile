# Plantilla de credenciales. Copiar a .env y completar con los datos reales.
#
#     copy .env.example .env        (Windows)
#     cp   .env.example .env        (Linux / macOS)
#
# .env esta en .gitignore y NUNCA se sube al repositorio. Este archivo si se
# versiona: documenta que variables necesita el proyecto sin exponer ninguna
# clave. Quien clone el repo sabe exactamente que tiene que completar.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=tu_password_aqui
